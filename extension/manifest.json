{
  "manifest_version": 3,
  "name": "Nightcell: Dark Mode for Google Sheets",
  "short_name": "Nightcell",
  "version": "1.1.0",
  "description": "A real dark mode for Google Sheets. Cells, charts and menus go dark, cell colours stay readable, and any installed font works.",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Nightcell",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "permissions": ["storage"],
  "host_permissions": ["https://docs.google.com/spreadsheets/*"],
  "content_scripts": [
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["src/font.js", "src/engine.js"],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": false
    },
    {
      "matches": ["https://docs.google.com/spreadsheets/*"],
      "js": ["src/bridge.js"],
      "css": ["src/ui.css"],
      "run_at": "document_start",
      "all_frames": false
    }
  ],
  "commands": {
    "toggle-dark": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "Turn dark mode on or off"
    }
  },
  "minimum_chrome_version": "111"
}
